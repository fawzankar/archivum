# Turso
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Admin bootstrap (used only when admin_users is empty)
ADMIN_USERNAME=
ADMIN_PASSWORD=
JWT_SECRET=

# Web Push study reminders and admin notifications (generate a VAPID key pair)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@archivum.app
CRON_SECRET=

# Cloudflare R2 PDF storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_TOKEN_ID=
R2_SECRET_ACCESS_KEY=
R2_TOKEN_VALUE=
R2_BUCKET_NAME=archivum
# Optional public URL. Leave empty when using a private bucket with signed downloads.
R2_PUBLIC_URL=

# ARCHIVUM file limits (enforced in code)
# Total stored files: 10 GB (10,000,000,000 bytes)
# Maximum single upload: 50 MB
# Optional: only set if your R2 bucket was created in a specific jurisdiction (eu, us, fedramp, fedramp-high).
R2_JURISDICTION=default
