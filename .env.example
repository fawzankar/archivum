# Required for production/Vercel
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token
BLOB_READ_WRITE_TOKEN=your-vercel-blob-token
JWT_SECRET=replace-with-a-long-random-secret

# Optional admin bootstrap values (only used when the database has no admin user)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-immediately

# Uploads are limited to 50 MB and use direct-to-Blob client uploads.

# Vercel Blob: connect the Blob store to this Vercel project.
# Vercel will provide BLOB_READ_WRITE_TOKEN automatically for the project.
