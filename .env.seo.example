# --- SEO (add these to Vercel > Settings > Environment Variables, then redeploy) ---
# Your real public address, no trailing slash. Used for canonical links, sitemap.xml and social previews.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
# Optional: paste the content value of the Google Search Console "HTML tag" verification meta tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Optional: Bing Webmaster Tools verification code.
NEXT_PUBLIC_BING_SITE_VERIFICATION=
